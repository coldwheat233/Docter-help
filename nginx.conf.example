# Nginx 反向代理配置（生产用）

将请求转发到 Gunicorn/Streamlit 后端。

```nginx
upstream medical_agent_backend {
    # 4 个 worker（CPU 8 核 * 2 + 1 = 17，物理机 4 个够用）
    server 127.0.0.1:8501 max_fails=3 fail_timeout=30s;
    # 多机部署时加更多 server:
    # server 10.0.0.2:8501 max_fails=3 fail_timeout=30s;
    # server 10.0.0.3:8501 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

server {
    listen 80;
    server_name medical-agent.example.com;

    # SSL
    listen 443 ssl http2;
    ssl_certificate /etc/nginx/ssl/medical-agent.crt;
    ssl_certificate_key /etc/nginx/ssl/medical-agent.key;

    # 通用设置
    client_max_body_size 10M;
    proxy_read_timeout 120s;  # LLM 调用长
    proxy_send_timeout 120s;
    proxy_connect_timeout 10s;

    # 限流（IP 级，10 RPS）
    limit_req_zone $binary_remote_addr zone=ip_limit:10m rate=10r/s;
    limit_req zone=ip_limit burst=20 nodelay;

    # WebSocket 支持（Streamlit 用）
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # 主路由
    location / {
        proxy_pass http://medical_agent_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;  # SSE 流式需要
    }

    # 健康检查（不转发到后端）
    location /health {
        access_log off;
        return 200 "OK\n";
    }

    # 静态资源（Streamlit 自带）
    location /static/ {
        proxy_pass http://medical_agent_backend;
        proxy_cache_valid 200 1d;
    }
}

# HTTP 重定向到 HTTPS
server {
    listen 80;
    server_name medical-agent.example.com;
    return 301 https://$server_name$request_uri;
}
```

## 启动

```bash
# 1. 启动后端
gunicorn -c gunicorn.conf.py web.wsgi:app

# 2. 启动 nginx
sudo systemctl restart nginx

# 3. 测试
curl https://medical-agent.example.com/health
```
