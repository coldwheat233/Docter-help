# ====== DeepSeek LLM ======
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-reasoner   # 推理模型，不支持 tool calling，本项目不用

# ====== OpenAI 备用 LLM（v3 模型降级）======
# 主 LLM (DeepSeek) 失败时自动切到此模型
# 申请地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ====== LangSmith 可观测 ======
# 申请地址：https://smith.langchain.com/settings
# 设为 true 启用 LLM 调用追踪（需要 API key）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=medical-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # 自托管才需要改

# ====== 数据库 ======
# SQLite 路径，相对项目根目录
DB_PATH=data/medical.db

# ====== 运行模式 ======
# 设为 true 跳过 LLM 真实调用，用 mock 跑通流程
MOCK_LLM=false

# ====== 业务配置 ======
# 排班生成天数（seed 时使用）
SCHEDULE_DAYS=30
# 科室数量
DEPARTMENT_COUNT=5
# 医生数量
DOCTOR_COUNT=20
